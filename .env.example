# ==============================================================================
# Meta Marketing Attribution & Executive BI Web App (Phase 1 & Phase 2)
# Bridge-Ready Environment Configuration (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Currency Defaults
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
MKT_DEFAULT_CURRENCY="PHP"
MKT_DEFAULT_TIMEZONE="Asia/Manila"

# ------------------------------------------------------------------------------
# 2. Supabase / PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
# Required for server-side webhook ingestion, CAPI updates, and hourly cron upserts
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ------------------------------------------------------------------------------
# 3. Meta Marketing & Graph API Configuration (/src/lib/meta-engine/*)
# ------------------------------------------------------------------------------
# Graph API Version (defaults to v21.0)
META_GRAPH_API_VERSION="v21.0"

# Ad Account ID prefixed with `act_` (used by meta-insights.ts & meta-actions.ts)
META_AD_ACCOUNT_ID="act_123456789012345"

# System User Permanent Access Token with `ads_management`, `ads_read`,
# `pages_messaging`, `pages_manage_engagement`, `instagram_manage_messages`,
# `instagram_manage_comments`, and `business_management`
META_ACCESS_TOKEN="EAABsbCS1iHgBO..."
META_SYSTEM_USER_ACCESS_TOKEN="EAABsbCS1iHgBO..."

# Facebook Page ID & Page Access Token (used for PSID profile lookup, Private Replies API & CAPI)
META_PAGE_ID="109876543210987"
META_PAGE_ACCESS_TOKEN="EAABsbCS1iHgBO..."

# Optional Instagram Business Account ID linked to the Facebook Page
META_IG_BUSINESS_ACCOUNT_ID="17841400000000000"

# ------------------------------------------------------------------------------
# 4. Meta Real-Time Webhook Security (/api/webhooks/meta)
# ------------------------------------------------------------------------------
# Custom verification string configured in Meta App Dashboard -> Webhooks
META_WEBHOOK_VERIFY_TOKEN="mkt_verify_2230747944153516"

# Meta App ID & App Secret used to validate `X-Hub-Signature-256` HMAC-SHA256 payload signatures
META_APP_ID="2230747944153516"
META_APP_SECRET="a1b2c3d4e5f60718293a4b5c6d7e8f90"

# ------------------------------------------------------------------------------
# 5. Meta Conversions API (CAPI) for Business Messaging
# ------------------------------------------------------------------------------
# Dataset ID (Pixel / Business Messaging Dataset ID) for `/{META_DATASET_ID}/events`
META_DATASET_ID="987654321098765"

# Optional Test Event Code from Meta Events Manager for testing CAPI payloads in development
META_CAPI_TEST_EVENT_CODE=""

# ------------------------------------------------------------------------------
# 6. In-House CRM Bridge Configuration
# ------------------------------------------------------------------------------
# Outbound Webhook: Endpoint on your In-House CRM that receives newly attributed Meta DM leads
CRM_WEBHOOK_URL="https://crm.yourdomain.com/api/integrations/meta-attribution/lead"

# Shared secret sent/verified in `x-bridge-secret` header between this app and the In-House CRM
INTERNAL_BRIDGE_SECRET="crm_shared_bridge_secret_change_me"

# ------------------------------------------------------------------------------
# 7. Phase 2: Gemini AI Comment-to-DM Shield Configuration
# ------------------------------------------------------------------------------
# Google Gemini API Key used by `meta-comments.ts` (`gemini-2.5-flash`) to classify
# incoming ad comments into PRICE_INQUIRY, SPAM_OR_TROLL, SUPPORT_COMPLAINT, or GENERAL_PRAISE
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# ------------------------------------------------------------------------------
# 8. Cron & Internal API Security
# ------------------------------------------------------------------------------
# Bearer secret used by Vercel Cron / GitHub Actions to trigger hourly Meta Insights & Watchdog sync
CRON_SECRET="cron_sync_shared_secret_change_me"
